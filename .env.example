APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Supabase public project URL and publishable/anon key. Never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# OpenAI is the only runtime provider. Tests inject fake OpenAI responses and
# never require this key.
AI_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini
REASONING_MODEL=gpt-5.4-mini
AI_API_KEY=
MAX_CONTEXT_TOKENS=3500
MAX_OUTPUT_TOKENS=700
AGENT_RETRIEVAL_K=10
AGENT_MAX_RETRIEVAL_K=20
OPENAI_DAILY_TOKEN_BUDGET=2500000

MAX_CONTEXT_ITEMS=10
MAX_QUERY_CHARS=1000
REQUEST_TIMEOUT_SECONDS=15
MAX_CONVERSATION_TURNS=4
MAX_CONVERSATION_CHARS=4000

# Optional server-to-server authenticity check. This never grants data access;
# the user's Supabase bearer token and RLS still determine authorization.
AGENT_SHARED_SECRET=
