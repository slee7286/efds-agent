APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Supabase public project URL and publishable key. Never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key only if a publishable key is not available.
SUPABASE_ANON_KEY=

# OpenAI is the only runtime provider. Tests inject fake OpenAI responses and
# never require this key.
AI_PROVIDER=openai

# Model tiering. Synthesis runs on the default tier. Planning and citation
# verification run on the cheap tier: short, structured, latency-tolerant work
# where a flagship model buys nothing.
DEFAULT_MODEL=gpt-5.6-terra
SMALL_MODEL=gpt-5.6-luna
# Flagship tier, used only when the planner had to rewrite or decompose the
# question. Set ESCALATE_DECOMPOSED_QUESTIONS=false to keep every request on
# the default tier.
REASONING_MODEL=gpt-6-astra
# Off by default: the flagship tier is configured but unused unless enabled.
# Turn it on only if a live eval shows the default tier losing multi-hop answers.
ESCALATE_DECOMPOSED_QUESTIONS=false

AI_API_KEY=
MAX_CONTEXT_TOKENS=3500
MAX_OUTPUT_TOKENS=700
OPENAI_DAILY_TOKEN_BUDGET=2500000

# Bounded agentic retrieval. The planner is gated: it runs only for questions
# that depend on history or bundle several asks, because unconditional query
# rewriting measurably hurts single-fact lookups.
ENABLE_QUERY_PLANNING=true
SUB_QUERY_LIMIT=3

# Post-generation citation audit. Unsupported claims lose their citation; if no
# cited claim survives, the answer is withheld rather than asserted.
ENABLE_CITATION_VERIFICATION=true
VERIFICATION_TIMEOUT_SECONDS=10

# Hybrid retrieval. The query embedding must match the embedding profile the
# corpus was indexed with, or the semantic branch is skipped rather than
# comparing vectors from different models.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Minimum cosine similarity for the semantic branch to contribute a candidate.
# Without a floor, rank fusion hands the whole corpus a near-equal score and
# ranking stops discriminating. Calibrate against the eval suite.
SEMANTIC_FLOOR=0.30

AGENT_RETRIEVAL_K=10
AGENT_MAX_RETRIEVAL_K=20
MAX_CONTEXT_ITEMS=10
MAX_QUERY_CHARS=1000
REQUEST_TIMEOUT_SECONDS=15
MAX_CONVERSATION_TURNS=4
MAX_CONVERSATION_CHARS=4000

# Required in production to keep direct callers from consuming model capacity.
# It never grants data access; user JWTs and RLS still determine authorization.
AGENT_SHARED_SECRET=
